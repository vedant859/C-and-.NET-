using System;
class Program { static void Main(){
 Console.Write("Rows: ");int m=int.Parse(Console.ReadLine()!);
 Console.Write("Columns: ");int n=int.Parse(Console.ReadLine()!);
 int[,] a=new int[m,n],b=new int[m,n];
 Console.WriteLine("Enter first matrix:");
 for(int i=0;i<m;i++)for(int j=0;j<n;j++)a[i,j]=int.Parse(Console.ReadLine()!);
 Console.WriteLine("Enter second matrix:");
 for(int i=0;i<m;i++)for(int j=0;j<n;j++)b[i,j]=int.Parse(Console.ReadLine()!);
 Console.WriteLine("Sum:");
 for(int i=0;i<m;i++){for(int j=0;j<n;j++)Console.Write((a[i,j]+b[i,j])+" ");Console.WriteLine();}
}}

Sample/result: [[1,2],[3,4]] + [[5,6],[7,8]] = [[6,8],[10,12]].
