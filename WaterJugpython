 if a==2 or b==2:
  print("States (4L, 3L):"); print(*path,sep="\\n"); break
 x=min(a,3-b); y=min(b,4-a)
 for s in {(4,b),(a,3),(0,b),(a,0),(a-x,b+x),(a+y,b-y)}:
