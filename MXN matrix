using System;
class Program { static void Main(){
 Console.Write("Rows: ");int m=int.Parse(Console.ReadLine()!);
 Console.Write("Columns: ");int n=int.Parse(Console.ReadLine()!);int[,] a=new int[m,n];
 for(int i=0;i<m;i++)for(int j=0;j<n;j++){Console.Write($"a[{i},{j}]: ");a[i,j]=int.Parse(Console.ReadLine()!);}
 Console.WriteLine("Transpose:");
 for(int j=0;j<n;j++){for(int i=0;i<m;i++)Console.Write(a[i,j]+" ");Console.WriteLine();}
}}

Sample/result: [[1,2,3],[4,5,6]] → [[1,4],[2,5],[3,6]].
